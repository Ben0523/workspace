<?xml version="1.0"?>

<launch>
	<arg name="rviz_file" default="$(find webcam_pkg)/rviz/test.rviz"/>
    <param name="/use_sim_time" value="false"/>
	
	<node pkg="webcam_pkg" type="webcam.py" name= "Webcam_pub" output= "screen"/>

	<node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_file)"/>
</launch>